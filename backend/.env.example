# ===== 平台对接 =====
# 高驰 COROS：走官方 MCP 通道（Build on COROS MCP），**无需申请凭据**——
# 首次授权时自动完成 OAuth 客户端注册（RFC 7591），只需配置账号区域。
# 区域可选：cn（中国大陆）/ eu（欧洲）/ us（美国）/ auto（按账号自动分流）
COROS_REGION=cn
COROS_REDIRECT_URI=http://localhost:8000/api/connections/coros/callback

# Garmin：两种方式二选一
# 1) Garmin Connect 个人账号（非官方库 garminconnect，个人自用）
GARMIN_EMAIL=
GARMIN_PASSWORD=
# 2) Garmin Health API（官方，需加入开发者计划）
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Strava 官方 API（个人开发者免费申请：https://www.strava.com/settings/api）
# 推荐链路：高驰 App 开启「同步到 Strava」→ 本平台经 Strava API 拉取真实分段/逐点曲线/轨迹
# 应用回调地址填 http://localhost:8000/api/connections/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/connections/strava/callback

# ===== 基础配置 =====
DATABASE_URL=sqlite:///./sport_platform.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ===== 本地 AI 教练（完全可选，不配置则教练退化为规则点评，平台功能不受影响）=====
# 架构：LLM 出意图，引擎出数字。大模型只组织语言，所有配速/心率/成绩数字由
# VDOT / 区间 / 规划引擎实时计算；课表改动一律走「提案 → 界面确认」才写入。
#
# 推荐口径：llama.cpp 的 llama-server（OpenAI 兼容），随平台启动自动拉起、
# 关闭平台自动停掉释放显存。需要准备：
#   1) llama.cpp 的 llama-server.exe（Windows CUDA/ CPU 版均可在 llama.cpp releases 下载），
#      解压后把目录填到 AI_LLAMA_DIR（或放到仓库根的 llama/ 目录）
#   2) 一个 GGUF 模型（Qwen3-8B / Qwen3-14B 的 Q4_K_M 量化是性价比起点，
#      ModelScope / HuggingFace 可下载），绝对路径填到 AI_MODEL_PATH
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=qwen3-8b
AI_TIMEOUT=120
# AI_MODEL_PATH=C:\path\to\Qwen3-8B-Q4_K_M.gguf
# AI_LLAMA_DIR=C:\path\to\llama-cpp
# 端点启用鉴权（llama-server --api-key 或前置代理）时必填，留空则不带 Authorization
AI_API_KEY=

# 可选：推测解码草稿模型（小模型起草、大模型验证，生成提速）
# AI_DRAFT_MODEL_PATH=C:\path\to\Qwen3-0.6B-Q8_0.gguf
# 解读端点家族（评估/预测/计划/周报/饮食）的专用模型名；留空与主模型同轨
# AI_MODEL_REVIEW=

# ===== 自动同步 =====
# 服务运行期间每隔 N 分钟为已连接平台增量拉取新数据（最近一年范围在手动同步时选择）。
# 0 = 关闭；可在「平台连接」页随时开关/调整（运行时设置存数据库，此处只是初始默认值）。
# 高驰官方 MCP 不支持 webhook 推送，定时拉取是保持数据实时更新的方式。
AUTO_SYNC_MINUTES=30
