# ===== Node / 前端构建产物 =====
node_modules/
web/dist/
# vite 在配置文件旁生成的临时 dep 快照（形如 vite.config.js.timestamp-1789717686279-*.mjs），
# 每次 dev/build 都可能留下一个，属运行期产物
web/vite.config.js.timestamp-*

# ===== 日志与临时文件 =====
*.log
logs/
*.tmp
*_tmp.*
repos_tmp.json
# AI 评测产物（tools/ai_eval.py --save）：本机模型跑出的分数，换机器即失效，
# 属环境相关数据，不入库。基线快照另存 backend/_eval/（同样在忽略范围内）。
.ai_eval_*.json

# ===== 临时调试脚本与抓包产物（严禁提交）=====
# 排查高驰接口时产生的探针脚本与原始响应。_raw_records.txt 含真实 GPS 坐标
# （起点经纬度）、活动 LabelId 与心率 —— 属于个人定位数据，绝不能进版本库。
backend/_*
backend/tools.json
tools.json

